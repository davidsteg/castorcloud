# Settings for docker-compose.yml (the TrueNAS beta). Copy to .env, fill in,
# chmod 600. The control-plane services read all of it; the node role and
# gatekeeper get only what docker-compose.yml passes them.

# --- Versions -------------------------------------------------------------
# The release to run: the image tag, v<VERSION> (e.g. v0.3.0).
CASTOR_VERSION=
# davidsteg/gatekeeper pinned by digest: davidsteg/gatekeeper:1.23.0@sha256:...
GATEKEEPER_IMAGE=
AUTHENTIK_TAG=2025.10

# --- The NAS --------------------------------------------------------------
NODE_POOL=tank
# gatekeeper-castor's config (toolkits.yaml, tools.yaml, identities.yaml) and log.
GATEKEEPER_CONFIG=/mnt/tank/castor/gatekeeper/config
GATEKEEPER_LOGS=/mnt/tank/castor/gatekeeper/logs
# gatekeeper_token, castord.crt/.key, node.crt/.key (docs/gatekeeper.md). chmod 600.
SECRETS_DIR=/mnt/tank/castor/secrets
# stat -c %g /var/run/docker.sock
DOCKER_GID=999

# --- Domain and TLS -------------------------------------------------------
BASE_DOMAIN=castorcloud.ch
BRAND_NAME=Castor Cloud
PUBLIC_SCHEME=https
ACME_EMAIL=
CF_DNS_API_TOKEN=
PORTAL_URL=http://portal:3000
# The address tenant stacks reach Authentik at: the NAS's LAN IP.
AUTH_HOST_IP=

# --- Database and identity ------------------------------------------------
POSTGRES_USER=pc
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://pc:<POSTGRES_PASSWORD>@postgres:5432/portal
AUTHENTIK_SECRET_KEY=
AUTHENTIK_BOOTSTRAP_EMAIL=
AUTHENTIK_BOOTSTRAP_PASSWORD=
AUTHENTIK_BOOTSTRAP_TOKEN=
PORTAL_OIDC_CLIENT_ID=portal
PORTAL_OIDC_CLIENT_SECRET=
AUTH_SECRET=

# --- Keys (openssl rand -hex 32 each) -------------------------------------
SECRETS_ENCRYPTION_KEY=
VOLUME_KEK=

# --- One box: tenants only on the NAS, no stacks here -----------------------
LOCAL_NODE=off
BETA=on

# --- AI -------------------------------------------------------------------
AI_PROVIDER=openrouter
AI_MODEL=openrouter/anthropic/claude-sonnet-4.5
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LITELLM_MASTER_KEY=
LITELLM_DB_PASSWORD=
# The node's LLM gateway (pc-node-llm-gateway), as castord reaches it.
LLM_GATEWAY_URL=http://<nas-lan-ip>:4000

# --- Optional -------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MAIL_SMTP_URL=
MAIL_FROM=Castor Cloud <hello@castorcloud.ch>
MONITOR_TELEGRAM_CHAT_ID=
MONITOR_TELEGRAM_BOT_TOKEN=
MONITOR_EMAIL_TO=
