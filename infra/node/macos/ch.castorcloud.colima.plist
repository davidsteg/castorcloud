<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Starts Colima at boot as the castor user, no login needed. Installed by bootstrap.sh. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>ch.castorcloud.colima</string>
  <key>UserName</key><string>castor</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/colima</string>
    <string>start</string>
    <string>--foreground</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/castor</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/castor/Library/Logs/colima.log</string>
  <key>StandardErrorPath</key><string>/Users/castor/Library/Logs/colima.log</string>
</dict>
</plist>
