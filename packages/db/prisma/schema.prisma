// Control-plane database: customers, their subscriptions, stacks and
// provisioning state. Customer data itself never lives here – it stays in
// each tenant's encrypted stack.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  PENDING       // signed up, waiting for payment
  PROVISIONING  // paid, stack being created
  ACTIVE
  SUSPENDED     // stack stopped (unpaid / cancelled), data kept during grace period
  DELETING
  DELETED
  FAILED
}

enum ServiceKind {
  PHOTOS    // Immich
  DOCS      // Paperless-ngx
  PLACES    // Dawarich
  FLIGHTS   // AirTrail
  ASSISTANT // Hermes agent
}

enum MemberRole {
  OWNER
  MEMBER
}

enum BillingInterval {
  MONTH
  YEAR
}

enum JobKind {
  PROVISION
  UPDATE   // services / storage / members changed
  SUSPEND
  RESUME
  DELETE
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum NodeKind {
  LOCAL // the Docker host the provisioner runs on (development), LUKS volumes
  MAC   // Mac mini: OpenZFS on macOS + Docker in Colima, driven over SSH
}

model Node {
  id          String    @id @default(cuid())
  name        String    @unique
  kind        NodeKind  @default(MAC)
  /// "local" = the Docker host the provisioner runs on (development)
  sshHost     String
  sshUser     String    @default("deploy")
  /// ZFS pool holding the tenant datasets (MAC nodes)
  zfsPool     String?
  /// What tenant containers resolve auth.<domain> to (extra_hosts); null = the platform default
  authHostIp  String?
  /// The Colima VM's LAN address: the control plane's Traefik forwards the
  /// node's tenant hosts to its edge proxy there (port 80)
  edgeHost    String?
  capacity    Int       // max tenant stacks on this node
  /// false = draining: keeps its tenants, gets no new ones
  enabled     Boolean   @default(true)
  // Measured by the provisioner (registration and health checks)
  poolSizeMb  Int?
  poolUsedMb  Int?
  poolHealth  String?
  memoryMb    Int?
  lastSeenAt  DateTime?
  lastError   String?
  tenants     Tenant[]
  createdAt   DateTime  @default(now())
}

model Tenant {
  id                   String          @id @default(cuid())
  slug                 String          @unique // <slug>.<BASE_DOMAIN>
  displayName          String
  locale               String          @default("de")
  status               TenantStatus    @default(PENDING)
  node                 Node?           @relation(fields: [nodeId], references: [id])
  nodeId               String?

  // Booked configuration (source of truth: the Stripe subscription)
  storageUnits         Int             @default(1) // x 100 GB
  extraMembers         Int             @default(0)
  /// Monthly AI credit in CHF (hard spending limit of the assistant), 0 = none
  aiCreditChf          Int             @default(0)
  billingInterval      BillingInterval @default(MONTH)

  // Storage, measured by the provisioner. The volume size is the hard quota.
  /// Size of the encrypted volume in MB. Larger than the booking only while
  /// a downgrade is held back because the data doesn't fit.
  storageVolumeMb      Int?
  storageUsedMb        Int?
  /// Used MB per service: { photos, docs, places, flights, system }
  storageByService     Json?
  storageMeasuredAt    DateTime?

  // Billing
  stripeCustomerId     String?         @unique
  stripeSubscriptionId String?         @unique
  subscriptionStatus   String?         // Stripe status: active, past_due, canceled, ...
  currentPeriodEnd     DateTime?
  /// When a suspended tenant's data is deleted for good (grace period)
  deleteAfter          DateTime?

  members              Member[]
  services             ServiceInstance[]
  secrets              Secret[]
  volumeKey            VolumeKey?
  jobs                 Job[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
}

model User {
  id           String   @id @default(cuid())
  authentikSub String   @unique // OIDC "sub" from Authentik
  email        String   @unique
  name         String?
  locale       String?
  isStaff      Boolean  @default(false) // access to the admin console
  memberships  Member[]
  createdAt    DateTime @default(now())
}

model Member {
  id        String     @id @default(cuid())
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId  String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  role      MemberRole @default(MEMBER)
  telegram  TelegramLink?
  createdAt DateTime   @default(now())

  @@unique([tenantId, userId])
}

/// A member's assistant on Telegram (opt-in), via the one Castor bot.
/// Created with a pairing code shown in the portal; linked once the member
/// sends that code to the bot.
model TelegramLink {
  id               String    @id @default(cuid())
  member           Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId         String    @unique
  /// SHA-256 of the pending pairing code; cleared once linked
  pairingCodeHash  String?   @unique
  pairingExpiresAt DateTime?
  /// Telegram user id (private chats only), set once linked
  telegramUserId   BigInt?   @unique
  telegramUsername String?
  /// The assistant conversation messages go to; /new starts another
  sessionId        String?
  linkedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model ServiceInstance {
  id           String      @id @default(cuid())
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId     String
  kind         ServiceKind
  /// Booked in the subscription. Unbooked services are stopped, data kept.
  enabled      Boolean     @default(true)
  version      String?     // upstream image tag currently deployed
  healthy      Boolean     @default(false)
  lastHealthAt DateTime?

  @@unique([tenantId, kind])
}

/// Tenant secrets (DB passwords, OIDC client secrets, API tokens),
/// AES-256-GCM encrypted with SECRETS_ENCRYPTION_KEY.
model Secret {
  id         String   @id @default(cuid())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId   String
  key        String
  ciphertext String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, key])
}

/// Data-encryption key of the tenant's encrypted volume, wrapped
/// (AES-256-GCM) with the key-encryption key. Never stored on a node.
model VolumeKey {
  id         String   @id @default(cuid())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId   String   @unique
  wrappedKey String
  kekVersion Int      @default(1)
  createdAt  DateTime @default(now())
}

model Job {
  id         String    @id @default(cuid())
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId   String
  kind       JobKind
  status     JobStatus @default(QUEUED)
  step       String?   // last completed step, shown on the welcome page
  error      String?
  log        String    @default("")
  createdAt  DateTime  @default(now())
  finishedAt DateTime?
}

/// Append-only record of security-relevant actions (key access, staff access,
/// deletions). Staff access to customer data is always logged here.
model AuditLog {
  id        String   @id @default(cuid())
  actor     String   // "system", "stripe", or a user id
  action    String   // e.g. "volume.unlock", "tenant.delete", "staff.break_glass"
  tenantId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

/// Processed Stripe webhook events, so retries are handled exactly once.
model StripeEvent {
  id        String   @id // Stripe event id
  type      String
  createdAt DateTime @default(now())
}

enum AlertSeverity {
  WARNING
  CRITICAL
}

/// Operator alerts raised by the monitor (docs/monitoring.md). One row per
/// condition key; a condition that clears and comes back reuses its row.
/// `summary` is what the notification says (no personal data: it may go to
/// Telegram); `details` is operator context that stays here.
model Alert {
  id          String        @id @default(cuid())
  /// e.g. "node:mini-1:space", "service:acme:photos", "authentik:event:<pk>"
  key         String        @unique
  severity    AlertSeverity
  summary     String
  details     Json?
  /// One-off events (a failed job, a security event) are sent once and never re-fire
  once        Boolean       @default(false)
  /// Consecutive checks that found the condition (debounce for flaky probes)
  hits        Int           @default(0)
  firstSeenAt DateTime      @default(now())
  lastSeenAt  DateTime      @default(now())
  /// Last notification sent for this alert; null = not sent (yet)
  notifiedAt  DateTime?
  resolvedAt  DateTime?

  @@index([resolvedAt])
}
