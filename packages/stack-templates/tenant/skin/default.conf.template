# Skin proxy: sits between Traefik and the tenant's services.
#  - routes <service>-<slug>.<domain> to the right container
#  - injects brand CSS + iframe bridge into every HTML page
#  - lets the tenant portal (and only it) embed the services
# ${PORTAL_ORIGIN} is filled in by the nginx image's envsubst at startup;
# nginx's own $variables are left alone.

map $host $pc_service {
    ~^(?<svc>photos|docs|places|flights)-  $svc;
}

map $pc_service $pc_upstream {
    photos   http://immich-server:2283;
    docs     http://paperless:8000;
    places   http://dawarich:3000;
    flights  http://airtrail:3000;
    default  "";
}

map $http_upgrade $connection_upgrade {
    default  upgrade;
    ""       close;
}

server {
    listen 80;
    # Docker's DNS, needed because proxy_pass uses a variable.
    resolver 127.0.0.11 valid=30s ipv6=off;

    client_max_body_size 0;          # photo/video uploads
    proxy_request_buffering off;
    proxy_read_timeout 600s;
    proxy_send_timeout 600s;

    location /_brand/ {
        alias /usr/share/nginx/brand/;
        add_header Cache-Control "public, max-age=300";
    }

    location / {
        if ($pc_upstream = "") { return 404; }

        proxy_pass $pc_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # sub_filter only works on uncompressed bodies.
        proxy_set_header Accept-Encoding "";
        sub_filter_once on;
        sub_filter '</head>' '<link rel="stylesheet" href="/_brand/theme.css"><link rel="stylesheet" href="/_brand/services/$pc_service.css"><script src="/_brand/bridge.js" defer></script></head>';

        # Upstream apps forbid framing; allow the tenant portal only.
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Content-Security-Policy;
        add_header Content-Security-Policy "frame-ancestors ${PORTAL_ORIGIN}" always;
    }
}
