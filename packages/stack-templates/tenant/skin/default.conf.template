# Skin proxy: sits between Traefik and the tenant's services.
#  - routes <service>-<slug>.<domain> to the right container
#  - routes assistant-<slug>.<domain> to Hermes' chat API (called by the
#    portal's server only, with the member's key; see the second server)
#  - injects brand CSS + iframe bridge into every HTML page
#  - lets the tenant portal (and only it) embed the services
#  - files-<slug> (OpenCloud) has its own server: OpenCloud's CSP, rendered
#    by castord, already allows the portal and nothing else, so it is kept
# ${PORTAL_ORIGIN} is filled in by the nginx image's envsubst at startup;
# nginx's own $variables are left alone.

map $host $pc_service {
    ~^(?<svc>photos|docs|places|flights)-  $svc;
}

map $pc_service $pc_upstream {
    photos   http://immich-server:2283;
    docs     http://paperless:8000;
    places   http://dawarich:3000;
    flights  http://airtrail:3000;
    default  "";
}

# First-run setup makes whoever calls it first the app's admin (Immich) or
# owner (AirTrail), with a password login. castord does it while
# provisioning, with the tenant's setup token; from anyone else it's a 404,
# also before castord got there.
map "$pc_service:$uri" $pc_setup_path {
    ~^photos:/api/auth/admin-sign-up/?$               1;
    ~^flights:/(setup|api/users/setup)(/.*)?$        1;
    default                                          0;
}

# A regex, not a string: a 48-character key doesn't fit nginx's map hash.
# Exact "" is checked before regexes, so an empty header never passes, and
# an empty token (~^$) matches nothing else: closed, not open.
map $http_x_castor_setup $pc_setup_token_ok {
    ""                       0;
    ~^${SKIN_SETUP_TOKEN}$   1;
    default                  0;
}

map "$pc_setup_path:$pc_setup_token_ok" $pc_setup_denied {
    "1:0"    1;
    default  0;
}

map $http_upgrade $connection_upgrade {
    default  upgrade;
    ""       close;
}

server {
    listen 80;
    # Docker's DNS, needed because proxy_pass uses a variable.
    resolver 127.0.0.11 valid=30s ipv6=off;

    client_max_body_size 0;          # photo/video uploads
    proxy_request_buffering off;
    proxy_read_timeout 600s;
    proxy_send_timeout 600s;

    location /_brand/ {
        alias /usr/share/nginx/brand/;
        add_header Cache-Control "public, max-age=300";
    }

    location / {
        if ($pc_upstream = "") { return 404; }
        if ($pc_setup_denied) { return 404; }

        proxy_pass $pc_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-Castor-Setup "";

        # sub_filter only works on uncompressed bodies.
        proxy_set_header Accept-Encoding "";
        sub_filter_once on;
        sub_filter '</head>' '<link rel="stylesheet" href="/_brand/theme.css"><link rel="stylesheet" href="/_brand/services/$pc_service.css"><script src="/_brand/bridge.js" defer></script></head>';

        # Upstream apps forbid framing; allow the tenant portal only.
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Content-Security-Policy;
        add_header Content-Security-Policy "frame-ancestors ${PORTAL_ORIGIN}" always;
    }
}

# Files: OpenCloud. Its own CSP (opencloud-csp.yaml) stays; only its
# X-Frame-Options (SAMEORIGIN) goes, so the portal can embed it.
server {
    listen 80;
    server_name ~^files-;
    resolver 127.0.0.11 valid=30s ipv6=off;
    set $pc_files http://opencloud:9200;

    client_max_body_size 0;          # large uploads
    proxy_request_buffering off;
    proxy_read_timeout 600s;
    proxy_send_timeout 600s;

    location /_brand/ {
        alias /usr/share/nginx/brand/;
        add_header Cache-Control "public, max-age=300";
    }

    location / {
        proxy_pass $pc_files;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # Server-sent events (notifications) and big downloads stream through.
        proxy_buffering off;

        proxy_set_header Accept-Encoding "";
        sub_filter_once on;
        sub_filter '</head>' '<link rel="stylesheet" href="/_brand/theme.css"><link rel="stylesheet" href="/_brand/services/files.css"><script src="/_brand/bridge.js" defer></script></head>';

        proxy_hide_header X-Frame-Options;
    }
}

# Assistant: Hermes' API server. Only the session chat endpoints of member
# profiles are reachable; everything else (default profile, cron, runs,
# dashboard) stays private to the stack.
server {
    listen 80;
    server_name ~^assistant-;
    resolver 127.0.0.11 valid=30s ipv6=off;
    set $pc_assistant http://assistant:8642;

    client_max_body_size 64k;

    location = /health {
        proxy_pass $pc_assistant;
    }

    location ~ ^/p/[a-z0-9-]+/api/sessions(/[A-Za-z0-9_-]+(/messages|/chat/stream)?)?$ {
        proxy_pass $pc_assistant;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        # Server-sent events: pass every token through as it arrives.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 600s;
    }

    location / {
        return 404;
    }
}
