{
  "name": "@pc/portal",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_EXTRA_CA_CERTS=../../.dev-certs/ca.crt next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "stripe:sync": "tsx scripts/stripe-sync.mts",
    "stacks:json": "tsx scripts/stacks-json.mts",
    "stripe:listen": "stripe listen --forward-to https://app.brand.localhost/api/stripe/webhook --skip-verify"
  },
  "dependencies": {
    "@pc/brand": "*",
    "@pc/core": "^0.0.0",
    "@pc/db": "*",
    "@pc/pricing": "^0.0.0",
    "@pc/stacks": "*",
    "dotenv": "^18.0.8",
    "next": "^16.4.1",
    "next-auth": "^5.0.0-beta.29",
    "nodemailer": "^10.1.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0"
  }
