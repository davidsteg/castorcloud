{
  "photos": [
    {
      "name": "search_photos",
      "title": "Search photos",
      "description": "Find the user's photos and videos. `query` is a free-text description of what is in the picture (e.g. 'dog on the beach', 'birthday cake'); combine with person, place and date filters. Returns date, place, people and a link per item, never the image itself.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "description": "What the photo shows",
            "type": "string",
            "maxLength": 200
          },
          "person": {
            "description": "Name of a person recognised in Photos",
            "type": "string",
            "maxLength": 100
          },
          "city": {
            "type": "string",
            "maxLength": 100
          },
          "country": {
            "type": "string",
            "maxLength": 100
          },
          "from": {
            "description": "Taken on or after (YYYY-MM-DD)",
            "type": "string"
          },
          "to": {
            "description": "Taken on or before (YYYY-MM-DD)",
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "list_people",
      "title": "List people in photos",
      "description": "Names of the people the user has named in Photos (face recognition runs locally).",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    }
  ],
  "docs": [
    {
      "name": "search_documents",
      "title": "Search documents",
      "description": "Full-text search over the user's scanned documents (invoices, contracts, letters, receipts). Returns title, date, sender, type, tags and a short matching excerpt. Use read_document for more text.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Words to look for, e.g. 'hotel lisbon invoice'"
          },
          "from": {
            "description": "Document date on or after (YYYY-MM-DD)",
            "type": "string"
          },
          "to": {
            "description": "Document date on or before (YYYY-MM-DD)",
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25
          }
        },
        "required": [
          "query"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "read_document",
      "title": "Read a document",
      "description": "Text (OCR) of one document found with search_documents, cut to at most 6000 characters. Use `offset` to continue reading a long document.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "maxChars": {
            "type": "integer",
            "minimum": 200,
            "maximum": 6000
          }
        },
        "required": [
          "id"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    }
  ],
