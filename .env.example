# ---- Global ----
# Local dev: *.brand.localhost resolves to 127.0.0.1 in browsers and Node.
# Production: your real domain, e.g. brand.cloud
BASE_DOMAIN=brand.localhost
BRAND_NAME=Castor Cloud
# https everywhere; local dev uses certs from infra/dev-certs/generate.sh
PUBLIC_SCHEME=https

# ---- Control-plane Postgres ----
POSTGRES_USER=pc
POSTGRES_PASSWORD=change-me-postgres

# ---- Authentik ----
AUTHENTIK_TAG=2025.10
# openssl rand -base64 60 | tr -d '\n'
AUTHENTIK_SECRET_KEY=change-me-authentik-secret
AUTHENTIK_BOOTSTRAP_EMAIL=admin@example.com
AUTHENTIK_BOOTSTRAP_PASSWORD=change-me-admin
# API token used by the provisioner (openssl rand -hex 32)
AUTHENTIK_BOOTSTRAP_TOKEN=change-me-api-token

# ---- Portal OIDC client (registered in Authentik via blueprint) ----
PORTAL_OIDC_CLIENT_ID=portal
PORTAL_OIDC_CLIENT_SECRET=change-me-portal-oidc-secret

# ---- Portal (Next.js, runs on the host in dev) ----
DATABASE_URL=postgresql://pc:change-me-postgres@localhost:5432/portal
REDIS_URL=redis://localhost:6379
# openssl rand -base64 32
AUTH_SECRET=change-me-auth-secret
# Key used to encrypt tenant secrets at rest (openssl rand -hex 32)
SECRETS_ENCRYPTION_KEY=change-me-64-hex-chars


# Volume key-encryption key (openssl rand -hex 32). Production: HSM / Vault transit.
VOLUME_KEK=change-me-64-hex-chars-kek

# Tenants go to Mac nodes (npm run node -w @pc/provisioner -- add ...). "off"
# keeps them off the Docker host the provisioner runs on (production).
LOCAL_NODE=on

# ---- Production TLS (npm run cp:up:prod): wildcard via Cloudflare DNS-01 ----
# Token: Cloudflare > My Profile > API Tokens, "Edit zone DNS" for this zone.
ACME_EMAIL=
CF_DNS_API_TOKEN=

# ---- Stripe (test mode keys from https://dashboard.stripe.com/test/apikeys) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Google login (Google Cloud Console > OAuth client, type Web) ----
# Redirect URI: https://auth.<BASE_DOMAIN>/source/oauth/callback/google/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Development without Stripe keys: signup provisions immediately (never in production)
DEV_SKIP_PAYMENT=false

# ---- Assistant / LLM (OpenAI-compatible endpoint) ----
# "openrouter" (default) or "swiss" (e.g. Infomaniak) – controls the privacy
# statement on the website, so it must match the real provider.
AI_PROVIDER=openrouter
# Model behind the gateway's "assistant" alias (LiteLLM model name)
AI_MODEL=openrouter/anthropic/claude-sonnet-4.5
# Provider endpoint; only used by the "swiss" config (OpenRouter's is built in)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Node-level LLM gateway (LiteLLM, infra/node). Master key: openssl rand -hex 32
# Without it the provisioner refuses to set up the assistant.
LITELLM_MASTER_KEY=
LITELLM_DB_PASSWORD=change-me-litellm-db
# How the control plane reaches the gateway: on a Mac node, http://<edgeHost>:4000
# (the provisioner publishes it there). One address: the assistant runs on one node.
LLM_GATEWAY_URL=http://localhost:4000
# Converts the CHF credit into the gateway's USD budget
AI_USD_PER_CHF=1.1

# ---- Backups (docs/backups.md) ----
# The backup box (infra/backup/README.md); unset = no backups.
BACKUP_TARGET=
BACKUP_INTERVAL_HOURS=6
# npm run backup -w @pc/provisioner -- db-keygen (the secret half stays offline)
BACKUP_DB_PUBLIC_KEY=
# Control-plane Postgres container, for the nightly pg_dumpall
BACKUP_PG_CONTAINER=pc-control-plane-postgres-1

# ---- Telegram (optional, one bot for all tenants: @BotFather) ----
# Unset = Telegram is not offered. Bot: npm run telegram -w @pc/provisioner
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ---- Monitoring and alerts (docs/monitoring.md): npm run monitor -w @pc/provisioner ----
# Telegram: your own chat with the Castor bot (TELEGRAM_BOT_TOKEN above, or a
# separate MONITOR_TELEGRAM_BOT_TOKEN). The chat id of a private chat is your
# Telegram user id (e.g. from @userinfobot); send the bot /start once first.
MONITOR_TELEGRAM_CHAT_ID=
MONITOR_TELEGRAM_BOT_TOKEN=
# E-mail for critical alerts: smtps://user:pass@host:465 or smtp://...:587 (STARTTLS is required)
MONITOR_SMTP_URL=
MONITOR_EMAIL_TO=
MONITOR_EMAIL_FROM=
# Read-only Authentik token for the sign-in checks (openssl rand -hex 32);
# the 40-monitor blueprint creates the service account that owns it.
MONITOR_AUTHENTIK_TOKEN=
# Optional dead-man's switch: pinged after every round; the service behind it
# alerts you when the pings stop (e.g. a self-hosted Healthchecks instance).
MONITOR_HEARTBEAT_URL=
MONITOR_INTERVAL_S=300
MONITOR_RENOTIFY_HOURS=12
# Hosts whose certificate is checked (default: BASE_DOMAIN and auth.BASE_DOMAIN),
# and where to connect if the public address isn't reachable from the LAN.
MONITOR_TLS_HOSTS=
MONITOR_TLS_ADDRESS=
